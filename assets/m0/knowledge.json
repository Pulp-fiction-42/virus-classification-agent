      "content": "def parse_kraken_report(path: Path) -> dict[str, Any]:\n    \"\"\"Parse one Kraken report and retain species below the Viruses clade.\"\"\"\n    total_reads = 0\n    viral_reads = 0\n    species: list[dict[str, Any]] = []\n    viral_depth: int | None = None\n    for line in path.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():",
      "sha256": "113243c96f8a799fc15e0b17e0b1e5da10e19bf117ff427589a79fa48e00dc5a"
    },
    {
