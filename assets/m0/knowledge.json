      "locator": "lines:58-64",
      "license": "unknown",
      "content": "        if rank == \"R\" and taxid == \"1\":\n            total_reads = max(total_reads, clade_reads)\n        if taxid == \"10239\" or name == \"Viruses\":\n            viral_reads = max(viral_reads, clade_reads)\n            viral_depth = depth\n            continue\n        if viral_depth is not None and depth <= viral_depth:",
      "sha256": "ef559dbdff6bba7f15d04ea586b87a640d10b8151313777c571365dedae3875d"
